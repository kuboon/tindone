// Cloudflare Workers deployment. `deno task build` writes everything below into dist/ first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tindone",
  // Generated by server/build.ts: the bundled app, plus its manifest and resvg's WebAssembly.
  "main": "dist/index.js",
  "compatibility_date": "2026-09-01",
  // The migration CLI bundled beside the database adapter imports node:fs and friends; nothing
  // calls them on Workers, but the imports have to resolve.
  "compatibility_flags": ["nodejs_compat"],
  // The client bundle, static/, sw.js and the web manifest. Served before the Worker runs; the
  // binding is how the Worker reads the OG card fonts.
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS"
  },
  // Secrets, set with `wrangler secret put <NAME>`:
  //   SESSION_SECRET, RP_SIGNING_KEY_JWK, TURSO_DATABASE_URL, TURSO_AUTH_TOKEN
  // RP_ORIGIN is this Worker's public origin — set it here once the domain is known (and add it to
  // id.kbn.one's AUTHORIZE_WHITELIST).
  "vars": {
    "IDP_ORIGIN": "https://id.kbn.one"
  },
  "observability": { "enabled": true }
}

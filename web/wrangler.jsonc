// Cloudflare Workers deployment. `deno task build` writes everything below into dist/ first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tindone",
  // Generated by server/build.ts: the bundled app and its client manifest.
  "main": "dist/index.js",
  "compatibility_date": "2026-09-01",
  // The client bundle, static/, sw.js and the web manifest. Served before the Worker runs.
  "assets": {
    "directory": "dist/public"
  },
  // The database. Migrated by `deno task db migrate --remote` (part of `deno task deploy`, which
  // Workers Builds runs), not by `wrangler d1 migrations`: the migrations are data-table's, under
  // db/migrations/. The id is repeated in deno.json's deploy task.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tindone",
      "database_id": "da8be679-c6be-4acb-b6a7-36dbb86b2b61"
    }
  ],
  // Secrets, set with `wrangler secret put <NAME>`:
  //   SESSION_SECRET, RP_SIGNING_KEY_JWK
  // RP_ORIGIN is this Worker's public origin: the clientId id.kbn.one knows it by (it has to be on
  // the IdP's AUTHORIZE_WHITELIST), and the base of the absolute URLs the app hands out.
  "vars": {
    "IDP_ORIGIN": "https://id.kbn.one",
    "RP_ORIGIN": "https://gtd.kbn.one"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  // Worker Previews (`deno task deploy:preview`, the Preview command of Workers Builds) inherit
  // nothing from above. They get their own database, `tindone-preview`, shared by every branch and
  // migrated by that task, so a branch never touches production data. RP_ORIGIN is left unset:
  // each Preview answers on its own origin. Secrets: `wrangler preview base-config secret put`.
  "previews": {
    "vars": {
      "IDP_ORIGIN": "https://id.kbn.one"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "tindone-preview",
        "database_id": "e5444ee5-209c-4e0f-8945-6fd986eba690"
      }
    ],
    "observability": {
      "logs": {
        "enabled": true,
        "invocation_logs": true
      },
      "traces": {
        "enabled": false
      }
    }
  }
}
